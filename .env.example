# Copy to .env and fill in. Loaded automatically by graph.py.

# LLM backend: ollama (default) | anthropic | openai
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web search (leave empty to use mock results)
BRAVE_API_KEY=
